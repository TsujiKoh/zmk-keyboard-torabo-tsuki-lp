#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1        &kp N2        &kp N3  &kp N4     &kp N5                        &kp N6   &kp N7    &kp N8         &kp N9    &kp N0                &kp BACKSPACE
&kp GRAVE  &kp Q         &kp W         &kp E   &kp R      &kp T                         &kp Y    &kp U     &kp I          &kp O     &kp P                 &kp LEFT_BRACKET
&kp TAB    &kp A         &kp S         &kp D   &kp F      &kp G   &mkp LCLK  &mkp LCLK  &kp H    &kp J     &kp K          &kp L     &kp SEMI              &kp SQT
&kp LSHFT  &kp Z         &kp X         &kp C   &kp V      &kp B   &mkp RCLK  &mkp RCLK  &kp N    &kp M     &kp COMMA      &kp DOT   &mt RIGHT_SHIFT FSLH  &kp RSHFT
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 4   &kp SPACE  &to 1   &to 2      &to 3      &kp RET  &kp BSPC  &kp BACKSPACE  &kp RGUI  &kp RIGHT_ALT         &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans     &trans  &trans    &trans  &trans  &trans                  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
&trans     &trans  &trans    &trans  &trans  &trans                  &trans  &kp F4   &kp F5   &kp F6   &trans  &kp RIGHT_BRACKET
&trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&kp LSHFT  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans
&kp LCTRL  &trans  &kp LALT  &trans  &trans  &to 0   &to 2   &to 3   &trans  &trans   &trans   &trans   &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans          &trans         &trans            &trans             &trans         &trans
&trans  &kp N1  &kp N2  &kp N3  &trans  &trans                  &trans          &trans         &trans            &trans             &trans         &trans
&trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &trans  &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON      &trans
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &trans  &trans  &trans  &trans  &to 1   &to 0   &to 3   &kp TAB         &kp DEL        &trans            &trans             &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans     &trans        &trans    &trans     &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&trans     &trans        &kp UP    &trans     &trans  &trans                  &kp HOME      &kp PG_UP     &kp PAGE_DOWN  &kp END     &kp ESCAPE         &trans
&trans     &kp LEFT      &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &kp LC(X)     &kp LC(C)     &kp RC(V)      &trans      &kp TAB            &trans
&kp LSHFT  &trans        &trans    &trans     &trans  &trans  &trans  &trans  &trans        &trans        &trans         &trans      &trans             &trans
&kp LCTRL  &kp LEFT_WIN  &trans    &trans     &trans  &to 1   &to 2   &to 0   &trans        &trans        &trans         &trans      &out OUT_USB       &out OUT_BLE
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&pointing_listener {
    scroller {
        layers = <4>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 16>;
    };
};
