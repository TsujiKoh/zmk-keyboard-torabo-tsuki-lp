#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1        &kp N2        &kp N3  &kp N4  &kp N5                        &kp N6   &kp N7    &kp N8         &kp N9    &kp N0                &kp BACKSPACE
&kp GRAVE  &kp Q         &kp W         &kp E   &kp R   &kp T                         &kp Y    &kp U     &kp I          &kp O     &kp P                 &kp LEFT_BRACKET
&kp TAB    &kp A         &kp S         &kp D   &kp F   &kp G   &mkp LCLK  &to 3      &kp H    &kp J     &kp K          &kp L     &kp SEMI              &kp SQT
&kp LSHFT  &kp Z         &kp X         &kp C   &kp V   &kp B   &mkp RCLK  &kp MINUS  &kp N    &kp M     &kp COMMA      &kp DOT   &mt RIGHT_SHIFT FSLH  &kp RSHFT
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 4   &to 0   &to 1   &to 2      &kp SPACE  &kp RET  &kp BSPC  &kp BACKSPACE  &kp RGUI  &kp RIGHT_ALT         &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans     &trans  &trans    &trans  &trans  &trans                     &trans     &kp F10  &kp F11  &kp F12  &trans  &trans
&trans     &trans  &trans    &trans  &trans  &trans                     &trans     &kp F7   &kp F8   &kp F9   &trans  &trans
&trans     &trans  &trans    &trans  &trans  &trans  &trans  &to 3      &trans     &kp F4   &kp F5   &kp F6   &trans  &trans
&kp LSHFT  &trans  &trans    &trans  &trans  &trans  &trans  &kp MINUS  &trans     &kp F1   &kp F2   &kp F3   &trans  &trans
&kp LCTRL  &trans  &kp LALT  &trans  &to 0   &to 1   &to 2   &kp SPACE  &kp ENTER  &trans   &trans   &trans   &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans          &trans         &trans            &trans             &trans         &kp BACKSPACE
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                     &trans          &trans         &trans            &trans             &trans         &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &to 3      &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON      &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &kp N0  &trans  &kp MINUS  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &trans  &trans  &trans  &to 0   &to 1   &to 2   &kp SPACE  &kp ENTER       &kp DEL        &trans            &trans             &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans     &trans        &trans  &trans  &trans  &trans                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans     &trans        &trans  &trans  &trans  &trans                     &kp HOME      &kp PG_UP     &kp PAGE_DOWN  &kp END       &kp ESCAPE    &kp C_VOLUME_UP
&trans     &trans        &trans  &trans  &trans  &trans  &trans  &to 3      &trans        &mkp LCLK     &mo 4          &mkp RCLK     &kp TAB       &kp C_VOLUME_DOWN
&kp LSHFT  &trans        &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)     &mkp RCLK     &kp C_MUTE
&kp LCTRL  &kp LEFT_WIN  &trans  &trans  &to 0   &to 1   &to 2   &kp SPACE  &kp ENTER     &trans        &trans         &trans        &out OUT_USB  &out OUT_BLE
            >;
        };

        layer_4 {
            bindings = <
&none   &none   &none   &none   &none  &none                        &none       &none           &none           &none            &none  &kp DEL
&none   &none   &none   &none   &none  &none                        &none       &none           &kp UP_ARROW    &none            &none  &kp RIGHT_BRACKET
&none   &none   &none   &none   &none  &none  &none  &none          &none       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none
&trans  &none   &none   &none   &none  &none  &none  &none          &none       &none           &none           &none            &none  &none
&trans  &trans  &trans  &trans  &none  &none  &none  &kp BACKSPACE  &kp DELETE  &none           &none           &none            &none  &none
            >;
        };
    };
};

&pointing_listener {
    scroller {
        layers = <4>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 8>;
    };
};
